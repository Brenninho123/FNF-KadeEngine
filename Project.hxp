import hxp.*;
import lime.tools.*;

class Project extends HXProject
{
	public function new()
	{
		super();

		meta.title = "Friday Night Funkin': Kade Engine";
		meta.packageName = "com.funkin.kade";
		meta.company = "The Kade Crew";
		meta.version = "0.0.1";
		meta.buildNumber = getBuildNumber();

		if (isMobile())
		{
			meta.title = "FNF: Kade Engine";
		}

		app.main = "Main";
		app.file = isMobile() ? "KadeEngine" : "Kade Engine";

		window.width = 1280;
		window.height = 720;
		window.background = 0x000000;
		window.hardware = true;
		window.vsync = false;
		window.fps = 0;
		window.antialiasing = 0;

		if (target == Platform.HTML5)
		{
			window.resizable = true;
		}

		if (platformType == PlatformType.DESKTOP)
		{
			window.orientation = Orientation.LANDSCAPE;
			window.fullscreen = false;
			window.resizable = true;
			window.vsync = false;
		}

		if (isMobile())
		{
			window.orientation = Orientation.LANDSCAPE;
			window.fullscreen = true;
			window.width = 1280;
			window.height = 720;
			window.resizable = false;
			haxedefs.set("mobileC", "1");

			addAssetPath("assets/shared/images/hitbox", "assets/shared/images/hitbox", "default");
		}

		sources.push("source");

		if (debug)
		{
			app.path = "export/debug";
		}
		else
		{
			app.path = "export/release";
			haxeflags.push("-dce full");
			haxeflags.push("--no-traces");
		}

		if (isAndroid())
		{
			if (targetFlags.exists("ONLY_ARM64"))
			{
				architectures = [Architecture.ARM64];
				app.path = debug ? "export/debug" : "export/release_arm64";
			}
			else if (targetFlags.exists("ONLY_ARMV7"))
			{
				architectures = [Architecture.ARMV7];
				app.path = debug ? "export/debug" : "export/release_armv7";
			}
			else
			{
				architectures = [Architecture.ARM64, Architecture.ARMV7];
			}

			config.set("android.permission.INTERNET", "true");
			config.set("android.permission.WRITE_EXTERNAL_STORAGE", "true");
			config.set("android.permission.READ_EXTERNAL_STORAGE", "true");
			config.set("android.permission.VIBRATE", "true");
			config.set("android.minimum-sdk-version", "21");
			config.set("android.target-sdk-version", "33");

			if (isRelease())
			{
				var envPath = Sys.getEnv("KEYSTORE_PATH");
				var envPassword = Sys.getEnv("KEYSTORE_PASSWORD");
				var envAlias = Sys.getEnv("KEYSTORE_ALIAS");
				var envAliasPassword = Sys.getEnv("KEYSTORE_ALIAS_PASSWORD");

				if (envPath != null && envPassword != null && envAlias != null)
				{
					keystore = new Keystore(envPath, envPassword, envAlias, envAliasPassword ?? envPassword);
				}
				else
				{
					Log.info("", "- Using local fallback keystore (key.keystore). Set KEYSTORE_PATH/KEYSTORE_PASSWORD/KEYSTORE_ALIAS env vars for CI/release signing.");
					keystore = new Keystore("key.keystore", "@ellawy09", "alafandy", "@ellawy09");
				}
			}
		}

		if (isWindows() && targetFlags.exists("32bit"))
		{
			architectures = [Architecture.X86];
			app.path = "export/32bit/windows";
		}

		if (isIOS())
		{
			config.set("ios.deployment-target", "12.0");
			config.set("ios.device", "universal");
		}

		var webTarget = (target == Platform.HTML5);
		var audioExclude = webTarget ? ["*.ogg"] : ["*.mp3"];

		addAssetPath("assets/preload", "assets", "default", null, audioExclude, false);

		var preloadAll = !webTarget;

		for (lib in ["songs", "shared", "tutorial", "week1", "week2", "week3", "week4", "week5", "week6"])
		{
			addAssetPath("assets/" + lib, null, lib, null, audioExclude, preloadAll);
		}

		addAsset("art/readme.txt", "do NOT readme.txt", "default", false);
		addAsset("LICENSE", "LICENSE.txt", "default", false);
		addAssetPath("assets/fonts", "assets/fonts", "default", null, null, true);

		haxelibs.push(new Haxelib("flixel"));
		haxelibs.push(new Haxelib("flixel-addons"));
		haxelibs.push(new Haxelib("hscript"));
		haxelibs.push(new Haxelib("actuate"));
		haxelibs.push(new Haxelib("extension-webm"));
		haxelibs.push(new Haxelib("flixel-ui"));
		haxelibs.push(new Haxelib("polymod"));

		if (target != Platform.HTML5)
		{
			haxelibs.push(new Haxelib("hxlua"));
		}

		if (!isAndroid() && !isIOS())
		{
			haxelibs.push(new Haxelib("newgrounds"));
		}

		if (isAndroid())
		{
			haxelibs.push(new Haxelib("extension-androidtools"));
		}

		if (isWindows())
		{
			haxelibs.push(new Haxelib("discord_rpc"));
		}

		haxedefs.set("FLX_NO_FOCUS_LOST_SCREEN", "1");
		haxedefs.set("FLX_NO_DEBUG", "1");
		haxedefs.set("NAPE_RELEASE_BUILD", "1");

		icons.push(new Icon("art/icon8.png", 8));
		icons.push(new Icon("art/icon16.png", 16));
		icons.push(new Icon("art/icon32.png", 32));
		icons.push(new Icon("art/icon64.png", 64));
		icons.push(new Icon("art/icon128.png", 128));
		icons.push(new Icon("art/icon256.png", 256));
		icons.push(new Icon("art/icon512.png", 512));
		icons.push(new Icon("art/iconOG.png"));
	}

	function isAndroid():Bool
		return target == Platform.ANDROID;

	function isIOS():Bool
		return target == Platform.IOS;

	function isWindows():Bool
		return target == Platform.WINDOWS;

	function isMobile():Bool
		return platformType == PlatformType.MOBILE;

	function isRelease():Bool
		return !debug;

	function getBuildNumber():String
	{
		var envBuild = Sys.getEnv("GITHUB_RUN_NUMBER");
		return envBuild != null ? envBuild : "1";
	}

	function addAsset(path:String, ?rename:String, ?library:String, embed:Bool = false):Void
	{
		var asset = new Asset(path, rename, null, embed, true);
		asset.library = library ?? "default";
		this.assets.push(asset);
	}

	function addAssetPath(path:String, ?rename:String, ?library:String, ?include:Array<String>, ?exclude:Array<String>, embed:Bool = false):Void
	{
		if (path == "" || !sys.FileSystem.exists(path) || !sys.FileSystem.isDirectory(path)) return;

		if (include == null) include = [];
		if (exclude == null) exclude = [];

		var targetPath = rename ?? path;
		if (targetPath != "") targetPath += "/";

		for (file in sys.FileSystem.readDirectory(path))
		{
			var fullPath = '${path}/${file}';

			if (sys.FileSystem.isDirectory(fullPath))
			{
				if (this.filter(file, ["*"], exclude))
				{
					addAssetPath(fullPath, '${targetPath}${file}', library, include, exclude, embed);
				}
			}
			else if (this.filter(file, include, exclude))
			{
				addAsset(fullPath, '${targetPath}${file}', library, embed);
			}
		}
	}
}
